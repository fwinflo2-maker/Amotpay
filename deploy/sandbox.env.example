# Sandbox credentials — load in your shell only. NEVER commit this file.
# Copy to sandbox.env.local and:  Get-Content sandbox.env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "env:$($matches[1].Trim())" -Value $matches[2].Trim() } }

AMOTPAY_API_URL=https://amotpay-api.nexustechnologies.cloud
AMOTPAY_ADMIN_PIN=

# Cashramp sandbox (new keys only — never reuse compromised credentials)
CASHRAMP_API_URL=https://staging.api.useaccrue.com/cashramp/api/graphql
CASHRAMP_PUBLIC_KEY=
CASHRAMP_SECRET_KEY=
CASHRAMP_WEBHOOK_SECRET=
CASHRAMP_ENVIRONMENT=sandbox

# Sumsub sandbox
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
