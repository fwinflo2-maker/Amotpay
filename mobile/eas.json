{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "env": {
        "AMOTPAY_PRODUCTION_BUILD": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "AMOTPAY_PRODUCTION_BUILD": "true"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    }
  }
}
