# Block access to secrets and sensitive files
<FilesMatch "^(\.env|\.env\..*|amotpay\.env|.*\.sql|.*\.key|.*\.pem|.*\.log)$">
    Require all denied
</FilesMatch>

# Deny access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Only allow API entry points
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(migrations?|bin|vendor|src)/ - [F,L]
</IfModule>
