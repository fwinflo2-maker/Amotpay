APP_ENV=development
APP_DEBUG=false
APP_URL=https://amotpay-api.nexustechnologies.cloud
APP_SECRET=change-this-to-a-random-64-char-string
ADMIN_PIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amotpay
DB_USER=amotpay
DB_PASSWORD=

# Legacy Magma (historical data only — new flows use Cashramp)
MAGMA_API_URL=https://api.magmaonepay.com
MAGMA_PRIVATE_KEY=
MAGMA_SECRET_KEY=
MAGMA_WEBHOOK_SECRET=
MAGMA_PAYOUTS_ENABLED=false

# Cashramp — sole financial provider
CASHRAMP_API_URL=https://staging.api.useaccrue.com/cashramp/api/graphql
CASHRAMP_PUBLIC_KEY=
CASHRAMP_SECRET_KEY=
CASHRAMP_WEBHOOK_SECRET=
CASHRAMP_ENVIRONMENT=sandbox

# Sumsub — identity / KYC
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level

JWT_EXPIRY_HOURS=168
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
TRANSFER_RATE_LIMIT_PER_MINUTE=10
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=
MAX_REQUEST_BODY_BYTES=65536
